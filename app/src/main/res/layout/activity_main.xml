<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#CDF0FF"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="8dp"
        android:textSize="24sp"
        android:textColor="@color/black"
        android:text="Avatar Legenda Aanga" />

    <LinearLayout
        android:layout_margin="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="8dp"
            android:textSize="24sp"
            android:layout_weight="1"
            android:textColor="@color/black"
            android:text="Losowa postać:" />
        <Button
            android:id="@+id/randomBTN"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#87CEEB"
            android:textColor="#003"
            android:text="Losuj"/>
    </LinearLayout>

    <LinearLayout
        android:layout_margin="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
            <RadioGroup
                android:id="@+id/radioGroup"
                android:layout_weight="1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="8dp"
                    android:textSize="24sp"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    android:text="Przynależność:" />

                <RadioButton
                    android:text="Plemie Wody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <RadioButton
                    android:text="Królestwo Ziemi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <RadioButton
                    android:text="Naród ognia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />
                <RadioButton
                    android:text="Nomadzi Powietrza"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />
            </RadioGroup>
        <Button
            android:id="@+id/affiliationBTN"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:backgroundTint="#87CEEB"
            android:textColor="#003"
            android:text="Szukaj"/>
    </LinearLayout>

    <LinearLayout
        android:layout_margin="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/nameOfCharacter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ems="10"
            android:inputType="text"
            android:hint="Imię postaci np. Aang"
            />

        <Button
            android:id="@+id/searchBTN"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#87CEEB"
            android:textColor="#003"
            android:text="Szukaj"/>
    </LinearLayout>


</LinearLayout>